# Resend API key used by app/api/contact/route.ts to send contact form
# submissions. Get one at https://resend.com and set it here locally,
# and as an env var in the Vercel project settings for production.
RESEND_API_KEY=

# Public URL of the looping ambient track played by
# components/ui/AmbientAudio.tsx. Deliberately a remote URL rather than a
# file in /public — the audio is hosted on Vercel Blob / Cloudinary /
# Supabase Storage so it stays out of the repo. Leave this unset and the
# player renders nothing (the site simply runs silent).
#
# The track must be one we hold the rights to — a licensed/royalty-free
# piece (Uppbeat, Pixabay Music, CC0) or Abdus's own. Not a rip from a
# streaming service.
NEXT_PUBLIC_AMBIENT_AUDIO_URL=
